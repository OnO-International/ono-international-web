---
import Layout from '../../layouts/Layout.astro';
import { onoSuiteDemo, verifiedDemoUrl } from '../../data/ono-suite';
const base = import.meta.env.BASE_URL;
const contact = `${base}contact?service=ono-suite`;
const oneDemo = verifiedDemoUrl(onoSuiteDemo.oneUrl);
const compassDemo = verifiedDemoUrl(onoSuiteDemo.compassUrl);
const intakePreview = compassDemo ? new URL('/join/preview', compassDemo).href : null;
const peopleSteps = [
  { title: '入社情報を入力', text: 'スタッフ本人がオンラインで入力。', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM4 22v-3a8 8 0 0 1 16 0v3' },
  { title: '雇用契約を確認・締結', text: '勤務条件の確認から、契約書の保管へ。', icon: 'M6 3h10l4 4v15H6ZM15 3v5h5M9 12h8M9 16h5M9 20h3' },
  { title: '所属店舗へ登録', text: '本部が確認し、働く店舗へ配属。', icon: 'M3 10l3-7h12l3 7M4 10v12h16V10M9 22v-7h6v7M3 10h18' },
  { title: 'POSで勤怠を記録', text: '打刻・勤務実績を本部の確認へ。', icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 7v6l4 2' },
  { title: 'Compassで給与明細', text: '勤怠と支給内容を確認し、本部で明細管理。', icon: 'M5 3h14v19l-3-2-4 2-4-2-3 2ZM9 7l3 4 3-4M12 11v6M9 12h6M9 15h6' },
  { title: '会計ソフトへ受渡し', text: '弥生会計など、ご利用の製品に合わせたCSV形式を確認。', icon: 'M3 5h11v15H3ZM6 9h5M6 13h5M17 10l5 4-5 4M12 14h10' },
];
---
<Layout title="OnO ONE・OnO COMPASS｜これだけあればいい。" description="店舗にはOnO ONE、本部にはOnO COMPASS。注文・会計・売上確認を支え、入社から勤怠・給与明細までつながる運営を目指します。実アプリの体験と導入相談はこちら。" image={`${base}images/ono-suite/restaurant-team.webp`}>
<article class="suite">
  <section class="hero">
    <div class="hero-photo"><img src={`${base}images/ono-suite/restaurant-team.webp`} alt="飲食店のスタッフが笑顔で働く利用イメージ" width="1536" height="1024" fetchpriority="high" /></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">OnO RESTAURANT SOLUTIONS</p>
      <h1>これだけ<br/>あればいい。</h1>
      <p class="hero-lead">お店と本部を、<br/>ひとつの流れへ。</p>
      <p class="hero-copy">注文・会計から、日々の数字の確認まで。<br/>現場の仕事と、本部の判断を支えます。</p>
      <div class="actions"><a class="button" href="#experience">実アプリを体験する <span aria-hidden="true">↗</span></a><a class="text-link" href="#connected">つながる業務を見る ↓</a></div>
      <p class="hero-plan">さらに、入社・契約・勤怠・給与明細へ。<br/><span>一連の統合は開発中です。</span></p>
    </div>
  </section>
  <div class="product-ribbon"><div class="wrap ribbon-inner"><p><small>店舗の毎日を支える</small><strong>OnO ONE</strong></p><span class="ribbon-line" aria-hidden="true">← <i></i> →</span><p><small>本部の判断を支える</small><strong>OnO COMPASS</strong></p><a href="#products">2つの製品、ひとつの運営思想 <span aria-hidden="true">↓</span></a></div></div>

  <section class="wrap section problem">
    <div class="section-heading"><p class="eyebrow">LESS REWORK. MORE TIME FOR PEOPLE.</p><h2>営業が終わっても、<br/>仕事が終わらない。</h2><p>売上の転記。店舗ごとに異なる報告。<br/>何度も登録するスタッフ情報。<br/>その情報の分断を、減らしていきたい。</p></div>
    <div class="change-visual" aria-label="情報が分かれた運営から、店舗と本部がつながる運営への方針">
      <div class="before"><span class="tiny">よくある運営の悩み</span><div class="papers"><span>売上の転記</span><span>別々の報告</span><span>名簿の再登録</span></div></div>
      <div class="change-arrow" aria-hidden="true">↓</div>
      <div class="after"><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M6 23 14 9h19l8 14M9 23v29h29V23M6 23h35M18 52V35h11v17M44 31h14v21H44M48 36h6M48 42h6"/></svg><div><span class="tiny">OnOが目指す運営</span><strong>現場の情報を、<br/>本部の次の判断へ。</strong></div></div>
    </div>
  </section>

  <section id="products" class="product-section one-section">
    <div class="wrap product-grid">
      <div class="product-copy"><p class="eyebrow">01 / FOR YOUR STORE</p><p class="wordmark">OnO <strong>ONE</strong></p><h2>忙しい現場に、<br/>迷わない流れを。</h2><p>予約・注文・会計から、勤怠や日報の確認まで。<br/>お店の一日に沿って、必要な仕事をまとめます。</p><ul class="feature-lines"><li><span>01</span>テーブル・予約を確認</li><li><span>02</span>注文から厨房の提供管理へ</li><li><span>03</span>会計・日報・売上を確認</li></ul><a class="text-link" href="#experience">お店の画面を操作する ↗</a></div>
      <figure class="screen-figure"><div class="device"><div class="device-bar"><i></i><i></i><i></i><span>OnO ONE / TABLE MANAGEMENT</span></div><a href={`${base}images/ono-suite/one-light.png`} target="_blank" rel="noopener noreferrer" aria-label="OnO ONEの画面を拡大する（新しいタブ）"><img src={`${base}images/ono-suite/one-light.png`} alt="OnO ONEのテーブル管理画面。架空の焼肉店の座席と予約状況。" width="1275" height="717" loading="lazy" /></a></div><figcaption><span>実アプリの画面例・架空データ</span><span>2026年11月11日確認</span></figcaption><div class="screen-caption"><span aria-hidden="true">↳</span><p>テーブルごとの状況を、<strong>ひと目で。</strong></p></div></figure>
    </div>
  </section>

  <section class="product-section compass-section">
    <div class="wrap product-grid reverse">
      <div class="product-copy"><p class="eyebrow">02 / FOR YOUR HEADQUARTERS</p><p class="wordmark">OnO <strong>COMPASS</strong></p><h2>各店の「いま」を、<br/>次の一手へ。</h2><p>店舗から届く数字を、本部で確認する。<br/>売上の確認や店舗間の比較を、日々の判断につなげます。</p><ul class="feature-lines"><li><span>01</span>店舗別の売上・営業状況</li><li><span>02</span>日報・月次の数字を比較</li><li><span>03</span>スタッフ・勤怠情報を確認</li></ul><a class="text-link" href="#experience">本部の画面を操作する ↗</a></div>
      <figure class="screen-figure"><div class="device"><div class="device-bar"><i></i><i></i><i></i><span>OnO COMPASS / DASHBOARD</span></div><a href={`${base}images/ono-suite/compass-light.png`} target="_blank" rel="noopener noreferrer" aria-label="OnO COMPASSの画面を拡大する（新しいタブ）"><img src={`${base}images/ono-suite/compass-light.png`} alt="OnO COMPASSの売上ダッシュボード。架空店舗の売上と月内の推移。" width="1280" height="720" loading="lazy" /></a></div><figcaption><span>実アプリの画面例・架空データ</span><span>2026年11月11日確認</span></figcaption><div class="screen-caption"><span aria-hidden="true">↳</span><p>数字を見る時間を、<strong>考える時間へ。</strong></p></div></figure>
    </div>
    <p class="wrap note product-note">利用できる機能・連携範囲は、導入する版と店舗の運用に合わせてご案内します。</p>
  </section>

  <section id="connected" class="connected section">
    <div class="wrap"><div class="section-heading centered"><p class="eyebrow">ONE CONNECTED OPERATION</p><h2>ひとつの注文から、<br/>お店全体の動きまで。</h2><p>現場で生まれた情報を、会計・日報、本部での確認へ。</p></div>
    <div class="operation-flow" aria-label="注文、会計と日報、本部確認の順につながる業務"><div><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M16 8h32v48H16ZM25 8v5h14V8M23 24h18M23 33h18M23 42h11"/></svg><small>STORE</small><h3>注文・提供</h3><p>現場の動きを記録</p></div><span aria-hidden="true">→</span><div><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M12 10h40v30H12ZM22 40v9M42 40v9M7 49h50v9H7M21 21h22M21 29h11"/></svg><small>DAILY OPERATION</small><h3>会計・日報</h3><p>一日の数字を確認</p></div><span aria-hidden="true">→</span><div><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M8 8v46h48M18 44V31h7v13M31 44V23h7v21M44 44V14h7v30M14 23l15-9 10 3L53 6"/></svg><small>HEADQUARTERS</small><h3>本部で確認する</h3><p>次の判断につなげる</p></div></div>
    </div>
  </section>

  <section id="people-flow" class="wrap section people-section">
    <div class="people-intro"><div><p class="eyebrow">THE NEXT CONNECTION / 統合開発中</p><h2>入社したその日から、<br/>人の情報も、ひと続きに。</h2></div><p>入社、契約、店舗配属、勤怠、給与明細。<br/>仕事のたびに登録し直さない運営へ。<br/>既存の入社アプリを継続しながら、<br/>Compassへの統合を進めています。</p></div>
    <div class="roadmap"><div class="roadmap-top"><strong>目指す業務の流れ</strong></div>
      <p class="phase-label">A / 入社から配属へ</p><ol class="people-row">{peopleSteps.slice(0,3).map((step,i) => <li><div class="step-top"><span class="step-no">0{i+1}</span><svg viewBox="0 0 26 26" aria-hidden="true"><path d={step.icon}/></svg></div><h3>{step.title}</h3><p>{step.text}</p>{i<2 && <span class="step-arrow" aria-hidden="true">→</span>}</li>)}</ol>
      <div class="phase-bridge"><span aria-hidden="true">↓</span><p><strong>03 店舗登録</strong> から <strong>04 勤怠記録</strong> へ、スタッフ情報を引き継ぐ構想</p></div>
      <p class="phase-label">B / 勤怠・給与明細と、会計業務</p><ol class="people-row" start="4">{peopleSteps.slice(3).map((step,i) => <li><div class="step-top"><span class="step-no">0{i+4}</span><svg viewBox="0 0 26 26" aria-hidden="true"><path d={step.icon}/></svg></div><h3>{step.title}</h3><p>{step.text}</p>{i===0 && <span class="step-arrow" aria-hidden="true">→</span>}{i===1 && <span class="step-arrow accounting-separator" aria-hidden="true">＋</span>}</li>)}</ol>
      <div class="accounting-source"><span class="accounting-source-label">会計へ渡すデータ</span><div class="accounting-route" aria-label="POS売上から仕訳CSVを作成し、会計ソフト側で取り込む流れ"><strong>POSの売上・レジ締め</strong><span aria-hidden="true">→</span><strong>仕訳CSVの作成・確認</strong><span aria-hidden="true">→</span><strong>会計ソフト側で取込・照合</strong></div><p>弥生会計などの会計ソフトへの受渡しは、売上仕訳CSVを基本に、対象製品・科目・取込形式を導入時に確認します。給与明細からの給与仕訳連携、会計ソフトへの直接API送信は未対応です。</p></div>
    </div>
    {intakePreview && <div class="intake-preview"><div><p class="eyebrow">STAFF ONBOARDING PREVIEW</p><h3>スタッフが受け取る入社画面を、<br/>そのままイメージできます。</h3><p>スマートフォンで見る入力項目と、提出までの6ステップを架空データで確認できます。このプレビューでは入力・送信・保存は行いません。</p></div><a class="button" href={intakePreview} target="_blank" rel="noopener noreferrer">入社画面のデモを見る <span aria-hidden="true">↗</span></a></div>}
    <div class="scope-notes"><p><strong>人事情報は、許可した本部担当者だけに。</strong><br/>入社・雇用契約はCompassの設定内で管理する設計です。</p><p>この図は統合後に目指す運営です。電子契約・全店舗連携を含む全工程が稼働済みではありません。税・社会保険料の自動計算や振込、会計ソフト本体は対象に含みません。CSVの作成は会計ソフト側への取込完了を意味せず、実製品での取込検証が必要です。</p></div>
  </section>

  <section class="human-section"><div class="human-photo"><img src={`${base}images/ono-suite/hq-planning.webp`} alt="本部の担当者が店舗運営について話し合う利用イメージ" width="1536" height="1024" loading="lazy" /></div><div class="human-copy"><p class="eyebrow">BUILT AROUND YOUR PEOPLE</p><h2>仕組みを整えて、<br/>人に向き合う時間を。</h2><p>一店舗から、多店舗を支える本部まで。<br/>システムにお店を合わせる前に、<br/>まず、いまの仕事の流れをお聞かせください。</p><a class="text-link" href={contact}>自分たちの運用で相談する ↗</a></div></section>

  <section id="experience" class="wrap section experience"><div class="section-heading centered"><p class="eyebrow">SEE IT. TRY IT. MAKE IT YOURS.</p><h2>説明より先に、<br/>触れて、確かめてください。</h2><p>架空の店舗データで、注文・会計から本部の確認まで。<br/>商談では、お店の一日に沿ってご案内します。</p></div><div class="demo-links">{oneDemo && <a href={oneDemo} target="_blank" rel="noopener noreferrer"><span>店舗の画面を体験</span><strong>OnO ONE</strong><i aria-hidden="true">↗</i></a>}{compassDemo && <a href={compassDemo} target="_blank" rel="noopener noreferrer"><span>本部の画面を体験</span><strong>OnO COMPASS</strong><i aria-hidden="true">↗</i></a>}{(!oneDemo || !compassDemo) && <a href={`${contact}&intent=demo`}><span>体験をご希望の方へ</span><strong>個別にご案内します</strong><i aria-hidden="true">↗</i></a>}</div><p class="note">実アプリの体験環境／架空データ。入力した注文・会計は保存され、ほかの体験者にも表示されます。個人情報は入力しないでください。実決済・外部送信は行いません。{onoSuiteDemo.release && ` 体験版：${onoSuiteDemo.release}`}</p></section>

  <section class="wrap faq-section"><div><p class="eyebrow">BEFORE WE START</p><h2>導入前に、<br/>知っておきたいこと。</h2></div><div class="faq"><details><summary>いま使っているレジや端末は使えますか？</summary><p>端末・ブラウザー・プリンター・決済サービスなどを確認し、利用できる構成をご案内します。すべての既存機器への対応をお約束するものではありません。</p></details><details><summary>入社から給与まで、すべて連携済みですか？</summary><p>一連の統合は開発中です。既存の入社アプリを継続しながら、データ引継ぎ・電子契約・店舗連携などを順に確認しています。導入時に実際に使える範囲をご説明します。</p></details><details><summary>弥生会計などの会計ソフトへ連携できますか？</summary><p>現段階は売上仕訳CSVの作成・取得と、会計ソフト側での取込・照合を分けて扱います。直接API送信や給与仕訳の自動連携は未対応です。ご利用の会計ソフト・科目・取込形式を確認し、実製品での検証後に導入範囲をご案内します。</p></details><details><summary>料金はどのように決まりますか？</summary><p>店舗数、必要な機能、初期設定、連携・サポート範囲を確認してお見積りします。まずは現在の運営状況をお聞かせください。</p></details></div></section>
  <section class="closing"><div class="wrap"><p class="eyebrow">YOUR STORE. YOUR NEXT CHAPTER.</p><h2>あなたのお店なら、<br/>どう使えるだろう。</h2><div><p>現場の困りごとから、導入範囲を一緒に整理します。</p><a class="button light" href={contact}>OnO ONE・COMPASSを相談する <span aria-hidden="true">↗</span></a></div></div></section>
</article>
</Layout>
<style>
