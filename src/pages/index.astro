---
import Layout from '../layouts/Layout.astro';
import StoryHero from '../components/StoryHero.astro';
import '../styles/home.css';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft).catch(() => []);
const latestPosts = posts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const base = import.meta.env.BASE_URL;

const services = [
  {
    title: 'AI構築・コンサルティング',
    desc: '飲食・美容・小売店向けのAI活用支援。集客・接客・売上管理を自動化し、お店の常識を塗り替えます。',
    lpHref: `${import.meta.env.BASE_URL}services/ai`,
    contactHref: `${import.meta.env.BASE_URL}contact`,
  },
  {
    title: '動画制作',
    desc: 'プロモーション動画からSNSコンテンツまで、伝わる映像でブランドの魅力を最大化します。',
    lpHref: `${import.meta.env.BASE_URL}services/video`,
    contactHref: `${import.meta.env.BASE_URL}contact`,
  },
  {
    title: '空中・水中ドローン撮影',
    desc: '空中ドローンによるダイナミックな空撮と、水中ドローンによる幻想的な映像。唯一無二のコンテンツを届けます。',
    lpHref: `${import.meta.env.BASE_URL}services/drone`,
    contactHref: `${import.meta.env.BASE_URL}contact`,
  },
  {
    title: 'フリーダイビング講習',
    desc: '安全で楽しいフリーダイビングの世界へ。初心者から上級者まで、法人福利厚生としても対応。',
    lpHref: `${import.meta.env.BASE_URL}services/freediving`,
    contactHref: `${import.meta.env.BASE_URL}contact`,
  },
];
---

<Layout title="HOME">
  <StoryHero />

  <section id="services" class="home-section services-section">
    <div class="section-heading"><div><p class="eyebrow">01 — WHAT WE DO</p><h2>SERVICE<span>私たちにできること</span></h2></div><p>テクノロジーとクリエイティビティを融合させ、<br class="hidden md:block"/>あなたのビジネスに新しい価値を提供します。</p></div>
    <a href={`${base}services/restaurant-web`} class="store-feature">
      <div><span class="eyebrow">FOR LOCAL BUSINESSES</span><h3>お店の「困った」を、<br/>まるごと、お任せ。</h3></div>
      <div><p>実店舗 Web集客支援パッケージ</p><p>ホームページ制作・SEO・MEO・Google口コミ対策。<br/>月額8万円、制作費・ドメイン・更新費用込み。</p><span class="text-link">詳しく見る ↗</span></div><span class="feature-arrow" aria-hidden="true">↗</span>
    </a>
    <div class="service-list">
      {services.map((service, i) => <article class="service-row"><span class="service-no">0{i + 1}</span><div><h3>{service.title}</h3><p>{service.desc}</p></div><div class="service-row-links"><a href={service.lpHref} aria-label={`${service.title}を詳しく見る`}>詳しく見る <span>↗</span></a><a href={service.contactHref}>このサービスを相談する ↗</a></div></article>)}
    </div>
  </section>

  <section class="home-section about-section">
    <div class="about-heading"><p class="eyebrow">02 — WHO WE ARE</p><h2>足りないなら<br/><span>一緒に作ればいい。</span></h2><div class="about-wordmark" aria-hidden="true">O<span>n</span>O</div></div>
    <div class="about-copy"><p>OnO INTERNATIONALは、ビジネスに必要なデジタルインフラをまるごと提供するパートナーです。</p><p>ホームページ・DXシステム・AI構築——まだ揃っていなくても大丈夫。何が必要かを一緒に整理して、ゼロから実装まで伴走します。コンサルで終わらず、勝ちに行くための仕組みを、一緒に作りにいきます。</p><a href={`${base}about`} class="text-link">私たちについて ↗</a><a href={`${base}services`} class="text-link">サービス一覧 ↗</a><div class="about-stats">{[{num:'100+', label:'プロジェクト実績'}, {num:'DX', label:'インフラ構築支援'}, {num:'AI',label:'最新技術導入'}, {num:'∞',label:'クリエイティビティ'}].map(stat => <div><strong>{stat.num}</strong><span>{stat.label}</span></div>)}</div></div>
  </section>

  <section class="home-section film-section" aria-label="OnOの映像">
    <div class="film-caption"><p class="eyebrow">A DIFFERENT PERSPECTIVE</p><span>映像がひらく、新しい視点。</span></div>
    <div class="film-frame"><iframe title="OnO INTERNATIONAL 紹介映像" src="https://www.youtube.com/embed/29EyujAPy4g?autoplay=1&mute=1&rel=0&playsinline=1" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
  </section>

  {latestPosts.length > 0 && <section class="home-section news-section"><div class="section-heading"><div><p class="eyebrow">03 — JOURNAL</p><h2>NEWS<span>最新情報</span></h2></div><a class="text-link" href={`${base}news`}>すべて見る ↗</a></div><div class="news-list">{latestPosts.map(post => <a href={`${base}news/${post.id}`}><time datetime={new Date(post.data.date).toISOString()}>{new Date(post.data.date).toLocaleDateString('ja-JP')}</time><span class="news-category">{post.data.category || 'NEWS'}</span><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>}

  <section class="home-section home-contact"><p class="eyebrow">OUR NEXT CHAPTER</p><h2>プロジェクトを<br/>一緒に始めましょう<span>。</span></h2><p>お気軽にお問い合わせください。<br/>あなたのビジョンを形にするお手伝いをします。</p><a href={`${base}contact`} class="button-primary">無料相談はこちら <span>↗</span></a></section>
</Layout>
