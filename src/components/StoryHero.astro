---
const base = import.meta.env.BASE_URL;
const chapters = [
  { num: '01', jp: ['小さなお店には', '関係ないと', '思われていました。'], en: "At first, we were told AI wasn't for small shops.", label: 'EVERY POSSIBILITY STARTS SMALL.' },
  { num: '02', jp: ['それでも、', '「自分たちにできることは', '何か」を考え続けてきました。'], en: 'Still, we kept asking ourselves what we could do.', label: 'A QUESTION THAT MOVES US.' },
  { num: '03', jp: ['小さな実店舗を、支えたい。', '小さい私たちだからできる、', 'まるごとのサポート。'], en: 'A small team, fully by your side. Complete support for local businesses.', detail: '小規模で実店舗を営む会社さんの力になりたい。その想いで、一店一店に向き合ってきました。', label: 'SMALL TEAM. FULL SUPPORT.' },
  { num: '04', jp: ['私たちは、', 'どんなときも', 'この信念を貫いてきました。'], en: "Through it all, we've stayed true to this belief.", label: 'ALWAYS, BY YOUR SIDE.' },
  { num: '05', jp: ['お店の常識を、', '一緒に', '塗り替えませんか。'], en: "Let's redefine what's possible for your business.", label: 'OUR NEXT CHAPTER, TOGETHER.' },
];
---

<section id="story-hero" class="story-hero" aria-label="OnOのブランドストーリー">
  <div class="story-scene">
    <div class="story-grid" aria-hidden="true"></div>
    <div class="story-stripes" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="story-side">
      <p class="eyebrow">ONE &amp; ONLY PARTNER</p>
      <p class="story-manifesto">小さなお店の、<br/>大きな可能性。</p>
      <div class="connection-mark" aria-hidden="true"><span>O</span><em>n</em><span>O</span></div>
      <p class="story-side-note">人と人。想いと未来。<br/>そのあいだに、OnO。</p>
    </div>

    <div id="story-stack" class="story-stack" tabindex="0" role="region" aria-label="ブランドストーリー。上下左右の矢印キーでも操作できます。">
      {chapters.map((chapter, i) => (
        <article class:list={['story-card', { 'is-active': i === 0 }]} data-index={i} aria-hidden={i !== 0} inert={i !== 0} style={`--offset: ${i}; z-index: ${chapters.length - i};`}>
          <div class="story-card-top"><span>OnO INTERNATIONAL</span><span>OUR STORY / {chapter.num}</span></div>
          <div class="story-card-body">
            <div class="story-number"><span>BRAND STORY</span><strong>{chapter.num}<small>.</small></strong></div>
            <div class="story-copy">
              {i === 0 ? <h1>{chapter.jp.map(line => <span>{line}</span>)}</h1> : <h2>{chapter.jp.map(line => <span>{line}</span>)}</h2>}
              {chapter.detail && <p class="story-detail">{chapter.detail}</p>}
              <p class="story-english">{chapter.en}</p>
            </div>
          </div>
          <div class="story-art" aria-hidden="true">
            <svg viewBox="0 0 480 205" fill="none">
              <path d="M10 183H474" stroke="currentColor"/>
              <path d="M116 180V67H336V180" fill="var(--paper)" stroke="currentColor" stroke-width="2"/>
              <path d="M105 69L125 30H327L347 69H105Z" fill="var(--orange)" stroke="currentColor" stroke-width="2"/>
              <path d="M105 69V82Q125 103 145 82Q165 103 185 82Q205 103 225 82Q245 103 265 82Q285 103 305 82Q326 103 347 82V69" fill="var(--paper)" stroke="currentColor" stroke-width="2"/>
              <path d="M145 68L158 31M185 68L191 31M225 68V31M265 68L259 31M305 68L292 31" stroke="var(--paper)" stroke-width="15"/>
              <path d="M139 110H231V158H139Z" fill="var(--blue)" fill-opacity=".12" stroke="currentColor" stroke-width="2"/>
              <path d="M253 108H312V181H253Z" fill="var(--blue)" stroke="currentColor" stroke-width="2"/>
              <path d="M186 110V158M139 145H231M300 143V152" stroke="var(--paper)" stroke-width="2"/>
              <path d="M376 182V152M367 164Q348 126 369 123Q389 125 377 156Q396 126 404 143Q409 157 376 166" stroke="currentColor" stroke-width="2"/>
              <path d="M360 165H392L388 183H364L360 165Z" fill="var(--orange)" stroke="currentColor" stroke-width="2"/>
              <path d="M54 86L61 68M71 92L86 80M49 111H29M397 47L405 29M417 57L435 47" stroke="var(--blue)" stroke-width="2" stroke-linecap="round"/>
              <path d="M70 183L77 135H101L109 183M75 153H104" stroke="currentColor" stroke-width="2"/>
              <text x="165" y="131" fill="currentColor" font-size="12" font-family="sans-serif" letter-spacing="2">OPEN</text>
              <circle cx="425" cy="102" r="22" fill="var(--paper)" stroke="currentColor"/>
              <path d="M416 102L422 108L435 94" stroke="var(--blue)" stroke-width="2"/>
            </svg>
            <span>{chapter.label}</span>
          </div>
          {i === 4 && <div class="story-actions"><a class="button-primary" href={`${base}services`}>サービスを見る <span>↗</span></a><a class="text-link" href={`${base}contact`}>お問い合わせ ↗</a></div>}
          <div class="story-card-bottom"><span>IDEAS INTO EVERYDAY.</span><span>0{i + 1} — 05</span></div>
        </article>
      ))}
    </div>

    <div class="story-fragments" aria-hidden="true" inert></div>
    <section class="story-introduction" aria-label="OnO INTERNATIONALについて" aria-hidden="true" inert>
      <p class="eyebrow">ABOUT US / OnO INTERNATIONAL</p>
      <div class="story-introduction-logo">
        <svg class="story-logo-assembly" viewBox="130 470 1340 690" role="img" aria-label="OnO International">
          <defs>
            <clipPath id="story-n-silhouette"><path d="M280 922 C520 890 610 774 666 596 C694 501 705 486 730 488 C768 490 783 569 807 689 L887 970 C970 780 1100 670 1325 710 C1130 720 1020 851 950 1052 C908 1178 857 1182 828 1078 L720 670 C658 834 519 960 280 922Z"/></clipPath>
            <mask id="story-n-draw" maskUnits="userSpaceOnUse" x="0" y="470" width="1600" height="690">
              <path class="story-n-trace" d="M280 922 C560 947 637 773 718 569 C750 510 815 1090 878 1080 C929 1070 966 712 1325 710" fill="none" stroke="white" stroke-width="165" stroke-linecap="round" pathLength="1"/>
            </mask>
          </defs>
          <image class="story-logo-circles" href={`${base}logo.png`} x="0" y="0" width="1600" height="1600"/>
          <image href={`${base}logo.png`} x="0" y="0" width="1600" height="1600" clip-path="url(#story-n-silhouette)" mask="url(#story-n-draw)"/>
        </svg>
      </div>
      <h2>O<span>と</span>OをN<span>で</span>結ぶ</h2>
      <p class="story-introduction-copy">OnO INTERNATIONALは、人と人、国と国、価値と価値を<br class="md:hidden"/>つなぐことを使命とする企業です。</p>
      <a class="text-link" href={`${base}about`}>私たちについて ↗</a>
      <a class="story-introduction-scroll" href="#services">SCROLL TO EXPLORE <span>↓</span></a>
    </section>
    <div class="story-controls">
      <span class="story-scroll-label">SCROLL</span>
      <span id="story-current" aria-live="polite" aria-atomic="true"><b>01</b><span class="sr-only"> / 05</span></span>
      <span class="story-progress"><i></i></span><span class="story-total">05</span>
      <div class="story-control-buttons"><button id="story-prev" aria-label="前のストーリー" disabled>↑</button><button id="story-next" aria-label="次のストーリー">↓</button></div>
    </div>
    <div class="story-bottom"><span>SCROLL TO DISCOVER <span aria-hidden="true">↓</span></span><a href="#services" id="story-skip">サービス紹介へ進む ↗</a></div>
  </div>
</section>

<script>
  const hero = document.getElementById('story-hero');
  const scene = hero?.querySelector<HTMLElement>('.story-scene');
  const cards = Array.from(hero?.querySelectorAll<HTMLElement>('.story-card') || []);
  const previous = document.getElementById('story-prev') as HTMLButtonElement;
  const next = document.getElementById('story-next') as HTMLButtonElement;
  const currentLabel = document.querySelector('#story-current b');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const mobile = window.matchMedia('(max-width: 767px)');
  const introduction = hero?.querySelector<HTMLElement>('.story-introduction');
  const fragments = hero?.querySelector<HTMLElement>('.story-fragments');
  const stack = hero?.querySelector<HTMLElement>('.story-stack');
  const lastStage = cards.length;
  let particleFrame = 0;
  function createFragments() {
    cancelAnimationFrame(particleFrame);
    if (!fragments || !stack || !scene || reducedMotion.matches) return;
    fragments.replaceChildren();
    const origin = scene.getBoundingClientRect();
    const logo = introduction?.querySelector('.story-introduction-logo')?.getBoundingClientRect();
    if (!logo) return;
    // The N sits at the centre of the original OnO mark. Measure it in the
    // scene so the same convergence point works on phones and desktop.
    const trace = introduction?.querySelector<SVGPathElement>('.story-n-trace');
    const matrix = trace?.getScreenCTM();
    if (!trace || !matrix) return;
    const length = trace.getTotalLength();
    const sources = [cards[cards.length - 1], hero?.querySelector<HTMLElement>('.story-side')].filter(Boolean) as HTMLElement[];
    const random = (n: number) => { const v = Math.sin(n * 127.1 + 311.7) * 43758.5453; return v - Math.floor(v); };
    const dots: { x: number; y: number; tx: number; ty: number; sx: number; sy: number; size: number; delay: number; color: string }[] = [];
    sources.forEach((source, sourceIndex) => {
      const box = source.getBoundingClientRect();
      const letters = (source.textContent || 'OnO').replace(/\s/g, '');
      // Keep the same path and arrival timing with fewer composited layers on phones.
      const count = mobile.matches ? (sourceIndex === 0 ? 240 : 80) : (sourceIndex === 0 ? 360 : 120);
      for (let i = 0; i < count; i++) {
        const seed = i + sourceIndex * 173;
        const x = box.left - origin.left + random(seed + 1) * box.width;
        const y = box.top - origin.top + random(seed + 2) * box.height;
        const size = 3 + random(seed + 3) * 10;
        const along = i / (count - 1);
        const point = trace.getPointAtLength(length * along).matrixTransform(matrix);
        const targetX = point.x - origin.left;
        const targetY = point.y - origin.top;
        const spreadX = 20 + random(seed + 4) * (origin.width - 40) - x;
        const spreadY = 100 + random(seed + 5) * (origin.height - 140) - y;
        if (mobile.matches) {
          dots.push({ x, y, tx: targetX, ty: targetY, sx: x + spreadX, sy: y + spreadY, size, delay: along * 1500, color: ['#f8f4e9','#315b83','#a8a39a','#b94b50','#d8bd7e'][i % 5] });
          continue;
        }
        const piece = document.createElement('span');
        piece.className = 'story-fragment' + (i % 4 === 0 ? ' is-letter' : i % 3 === 0 ? ' is-spark' : '');
        if (i % 4 === 0) piece.textContent = letters[i % letters.length];
        piece.style.cssText = `left:${x}px;top:${y}px;width:${size}px;height:${size}px;--fly-x:${spreadX}px;--fly-y:${spreadY}px;--land-x:${targetX-x-size/2}px;--land-y:${targetY-y-size/2}px;--spin:${random(seed+6)*720-360}deg;--delay:${along*1500}ms;--piece-color:${['#f8f4e9','#315b83','#a8a39a','#b94b50','#252921'][i%5]};`;
        fragments.append(piece);
      }
    });
    if (dots.length) {
      // One bitmap surface instead of hundreds of animated, clipped DOM layers.
      const canvas = document.createElement('canvas');
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(origin.width * ratio);
      canvas.height = Math.round(origin.height * ratio);
      canvas.style.cssText = 'width:100%;height:100%;display:block';
      fragments.append(canvas);
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.scale(ratio, ratio);
      let start = 0;
      const draw = (now: number) => {
        if (!hero?.classList.contains('is-introducing')) return;
        if (!start) start = now;
        const elapsed = now - start;
        ctx.clearRect(0, 0, origin.width, origin.height);
        for (const dot of dots) {
          const t = (elapsed - dot.delay) / 2450;
          if (t < 0 || t >= 1) continue;
          // A continuous quadratic path spreads outward and bends into the N.
          const u = 1 - t;
          const x = u*u*dot.x + 2*u*t*dot.sx + t*t*dot.tx;
          const y = u*u*dot.y + 2*u*t*dot.sy + t*t*dot.ty;
          const size = dot.size * (1 - .9*t);
          ctx.globalAlpha = Math.min(1, t*12, (1-t)*10);
          ctx.fillStyle = dot.color;
          ctx.fillRect(x-size/2, y-size/2, size, size);
        }
        if (elapsed < 4000) particleFrame = requestAnimationFrame(draw);
        else ctx.clearRect(0, 0, origin.width, origin.height);
      };
      particleFrame = requestAnimationFrame(draw);
    }
  }

  let stageIndex = 0;
  let current = -1;
  let frame = 0;

  function render() {
    frame = 0;
    if (!hero || !scene) return;
    const progress = stageIndex / lastStage;
    const index = stageIndex;
    hero.style.setProperty('--story-progress', String(progress));
    if (index === current) return;
    if (index !== lastStage) cancelAnimationFrame(particleFrame);
    if (index === lastStage) createFragments();
    hero.classList.toggle('is-introducing', index === lastStage);
    introduction?.setAttribute('aria-hidden', String(index !== lastStage));
    if (introduction) introduction.inert = index !== lastStage;
    if (stack) stack.inert = index === lastStage;
    current = index;
    cards.forEach((card, i) => {
      const offset = i - current;
      card.classList.toggle('is-active', offset === 0);
      card.classList.toggle('is-past', offset < 0);
      card.style.setProperty('--offset', String(Math.max(0, offset)));
      card.style.zIndex = String(cards.length - i);
      card.setAttribute('aria-hidden', String(offset !== 0));
      card.inert = offset !== 0;
    });
    if (currentLabel) currentLabel.textContent = current === lastStage ? 'ABOUT' : String(current + 1).padStart(2, '0');
    const countSuffix = hero.querySelector<HTMLElement>('#story-current .sr-only');
    if (countSuffix) countSuffix.textContent = current === lastStage ? ' 会社紹介' : ' / 05';
    previous.disabled = current === 0;
    next.disabled = current === lastStage;
  }
  function go(delta: number) {
    if (!hero || !scene) return;
    const target = Math.max(0, Math.min(lastStage, current + delta));
    stageIndex = target;
    render();
  }
  previous?.addEventListener('click', () => go(-1));
  next?.addEventListener('click', () => go(1));
  // One wheel gesture turns one card; ignore its momentum until it settles.
  let wheelLast = -Infinity;
  let wheelTurn = -Infinity;
  hero?.addEventListener('wheel', (event) => {
    if (event.ctrlKey || Math.abs(event.deltaY) <= Math.abs(event.deltaX) || Math.abs(hero.getBoundingClientRect().top) > 2) return;
    const now = performance.now();
    const fresh = now - wheelLast > 180 && now - wheelTurn > 450;
    wheelLast = now;
    const direction = event.deltaY > 0 ? 1 : -1;
    const canTurn = direction > 0 ? current < lastStage : current > 0;
    if (canTurn || !fresh) event.preventDefault();
    if (fresh && canTurn) {
      wheelTurn = now;
      go(direction);
    }
  }, { passive: false });
  // Keep the document still while swiping cards on phones. A fresh swipe
  // after the company introduction resumes native scrolling, including browser chrome.
  let touchStart: { x: number; y: number; index: number } | null = null;
  let consumed = false;
  hero?.addEventListener('touchstart', (event) => {
    touchStart = mobile.matches && event.touches.length === 1 && Math.abs(hero.getBoundingClientRect().top) < 2
      ? { x: event.touches[0].clientX, y: event.touches[0].clientY, index: current } : null;
    consumed = false;
  }, { passive: true });
  hero?.addEventListener('touchmove', (event) => {
    if (!touchStart || event.touches.length !== 1) return;
    const dy = touchStart.y - event.touches[0].clientY;
    const dx = touchStart.x - event.touches[0].clientX;
    if (!consumed && Math.abs(dx) > Math.abs(dy)) return;
    const canTurn = dy > 0 ? touchStart.index < lastStage : touchStart.index > 0;
    if (!consumed && !canTurn) return;
    if (event.cancelable) event.preventDefault();
    if (!consumed && Math.abs(dy) >= 40) {
      go(dy > 0 ? 1 : -1);
      consumed = true;
    }
  }, { passive: false });
  const endTouch = () => { touchStart = null; consumed = false; };
  hero?.addEventListener('touchend', endTouch);
  hero?.addEventListener('touchcancel', endTouch);
  hero?.addEventListener('keydown', (event) => {
    if (event.target instanceof HTMLElement && event.target.closest('a, button, input, textarea, select')) return;
    if (['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft'].includes(event.key)) {
      event.preventDefault();
      go(event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : -1);
    }
  });
  function scheduleRender() { if (!frame) frame = requestAnimationFrame(render); }
  window.addEventListener('scroll', scheduleRender, { passive: true });
  window.addEventListener('resize', scheduleRender);
  render();
</script>
