---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const connections = [
  { a: '心', b: '感動' },
  { a: '人', b: '人' },
  { a: '日本', b: '韓国' },
  { a: '一つ', b: '世界' },
];
---

<Layout
  title="会社概要"
  description="OnO INTERNATIONALは、人と人、国と国、価値と価値をつなぐことを使命とする企業です。代表・小野秀太が韓国での映像制作・起業経験を経て、日本を拠点に国境を越えたビジネス活動を展開しています。"
>

  <!-- Hero -->
  <section class="relative pt-32 pb-24 px-6 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-1/4 left-1/3 w-[500px] h-[500px] rounded-full bg-sand blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-80 h-80 rounded-full bg-sand blur-3xl"></div>
    </div>
    <div class="relative z-10 w-full max-w-4xl mx-auto flex flex-col items-center text-center">
      <p class="text-blue text-sm font-medium tracking-widest mb-8">ABOUT US</p>

      <!-- ロゴ大きく表示 -->
      <div class="mb-4 overflow-hidden w-[260px] md:w-[600px] h-[160px] md:h-[350px]">
        <img
          src={`${base}logo.png`}
          alt="OnO International"
          class="w-full h-full object-cover object-center"
        />
      </div>

      <h1 class="w-full text-3xl md:text-6xl font-black text-ink mb-6 leading-tight text-center">O<span class="accent-text">と</span>OをN<span class="accent-text">で</span>結ぶ</h1>
      <p class="text-muted text-lg max-w-2xl leading-relaxed">
        OnO INTERNATIONALは、人と人、国と国、<br class="hidden md:block"/>
        価値と価値をつなぐことを使命とする企業です。
      </p>
    </div>
  </section>

  <!-- Name の意味 -->
  <section class="pb-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="paper-panel rounded-3xl p-10 md:p-16 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-72 h-72 bg-sand rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-72 h-72 bg-sand rounded-full blur-3xl"></div>
        <div class="relative z-10">
          <p class="text-blue text-sm font-medium tracking-widest mb-4 text-center">THE NAME</p>
          <h2 class="text-3xl md:text-4xl font-black text-ink mb-6 text-center">
            OnOという<br class="md:hidden"/>名前の意味
          </h2>
          <p class="text-muted text-center max-w-2xl mx-auto mb-12 leading-relaxed">
            OとOをNで結ぶ——それがOnOという名前に込められた想いです。
          </p>

          <!-- O n O ビジュアル -->
          <div class="flex items-center justify-center gap-4 mb-14">
            <div class="w-20 h-20 rounded-full flex items-center justify-center text-ink font-black text-3xl"
              style="background: var(--orange); color: var(--paper);">O</div>
            <div class="flex flex-col items-center">
              <span class="text-muted text-5xl font-black" style="font-style: italic;">n</span>
            </div>
            <div class="w-20 h-20 rounded-full flex items-center justify-center text-ink font-black text-3xl"
              style="background: var(--blue); color: var(--paper);">O</div>
          </div>

          <!-- つながり一覧 -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {connections.map((c) => (
              <div class="bg-sand rounded-2xl p-5 text-center border border-line flex flex-col items-center justify-center">
                <div class="flex items-center justify-center gap-2 mb-1">
                  <span class="text-ink font-bold text-lg">{c.a}</span>
                  <span class="text-blue text-sm">と</span>
                  <span class="text-ink font-bold text-lg">{c.b}</span>
                </div>
                <div class="text-muted text-xs mt-1">を結ぶ</div>
              </div>
            ))}
          </div>

          <p class="text-muted text-center mt-10 leading-relaxed">
            あらゆる価値をつなぎ、<span class="text-ink font-semibold">幸せと幸せを結ぶ架け橋</span>となること。
            それがOnO INTERNATIONALの存在意義です。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- One & Only -->
  <section class="pb-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Philosophy -->
        <div class="paper-panel rounded-3xl bg-paper p-10">
          <div class="w-14 h-14 rounded-2xl bg-sand flex items-center justify-center text-2xl mb-6">💎</div>
          <span class="text-xs font-medium px-3 py-1 rounded-full text-blue bg-sand mb-4 inline-block">PHILOSOPHY</span>
          <h3 class="text-2xl font-black text-ink mb-4">One &amp; Only</h3>
          <p class="text-muted leading-relaxed">
            私たちは、すべての人が唯一無二の存在であるという「One & Only」の思想を大切にしています。
            国籍や文化、業種や規模に関わらず、あなたのビジネスには他にはない固有の価値があります。
            その価値を最大限に引き出すことが、私たちの使命です。
          </p>
        </div>

        <!-- Vision -->
        <div class="paper-panel rounded-3xl bg-paper p-10">
          <div class="w-14 h-14 rounded-2xl bg-sand flex items-center justify-center text-2xl mb-6">🌍</div>
          <span class="text-xs font-medium px-3 py-1 rounded-full text-blue bg-sand mb-4 inline-block">VISION</span>
          <h3 class="text-2xl font-black text-ink mb-4">世界をつなぐ</h3>
          <p class="text-muted leading-relaxed">
            国境や文化の違いを超え、世界中の人々がそれぞれの幸せを実現できる社会をつくる。
            テクノロジーと映像の力で、あらゆる垣根をなくし、
            すべての人が輝けるビジネス環境を創造し続けます。
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- 代表プロフィール -->
  <section class="pb-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-blue text-sm font-medium tracking-widest mb-3">FOUNDER</p>
        <h2 class="text-2xl md:text-4xl font-black text-ink">代表者紹介</h2>
      </div>

      <div class="paper-panel rounded-3xl bg-paper p-10 md:p-14">
        <div class="flex flex-col md:flex-row gap-10 items-start">

          <!-- アイコン -->
          <div class="flex-shrink-0 mx-auto md:mx-0">
            <img
              src={`${base}images/秀太似顔絵.jpg`}
              alt="小野 秀太"
              class="w-32 h-32 rounded-3xl object-cover object-top"
            />
            <div class="text-center mt-4">
              <p class="text-ink font-bold text-lg">小野 秀太</p>
              <p class="text-blue text-sm">Shuta Ono</p>
              <p class="text-muted text-xs mt-1">代表</p>
            </div>
          </div>

          <!-- テキスト -->
          <div class="flex-1">
            <div class="space-y-5 text-muted leading-relaxed">
              <p>
                韓国の大学を卒業後、韓国の映像プロダクションにて映画制作・撮影などの現場を経験。
                その後、韓国で起業し、<span class="text-ink">10年以上にわたり経営に携わってきました</span>。
              </p>
              <p>
                現在は日本を拠点に、国境を越えたビジネス活動を展開。
                日韓の文化とビジネスを深く理解した視点から、
                <span class="text-ink">AIの活用・映像制作・ドローン撮影</span>を通じて、
                クライアントのビジネスに新しい価値を届けています。
              </p>
              <p>
                「OnO」という社名に込めた想い通り、
                <span class="text-ink">あらゆる境界を越えて人と価値をつなぐこと</span>を
                ライフワークとしています。
              </p>
            </div>

            <!-- キャリアタイムライン -->
            <div class="mt-8 space-y-4">
              <div class="flex gap-4 items-start">
                <div class="w-2 h-2 rounded-full bg-sky-400 mt-2 flex-shrink-0"></div>
                <div>
                  <p class="text-ink text-sm font-semibold">韓国・大学卒業</p>
                  <p class="text-muted text-xs">韓国の映像プロダクションに入社</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="w-2 h-2 rounded-full bg-purple-400 mt-2 flex-shrink-0"></div>
                <div>
                  <p class="text-ink text-sm font-semibold">映画制作・撮影の現場を経験</p>
                  <p class="text-muted text-xs">韓国映像プロダクションにて実務を習得</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="w-2 h-2 rounded-full bg-teal-400 mt-2 flex-shrink-0"></div>
                <div>
                  <p class="text-ink text-sm font-semibold">韓国で起業</p>
                  <p class="text-muted text-xs">10年以上にわたり経営に携わる</p>
                </div>
              </div>
              <div class="flex gap-4 items-start">
                <div class="w-2 h-2 rounded-full bg-sand mt-2 flex-shrink-0"></div>
                <div>
                  <p class="text-ink text-sm font-semibold">OnO International 設立</p>
                  <p class="text-muted text-xs">日本を拠点に国境を越えたビジネス活動を展開</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 会社概要テーブル -->
  <section class="pb-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-blue text-sm font-medium tracking-widest mb-3">COMPANY INFO</p>
        <h2 class="text-2xl md:text-4xl font-black text-ink">会社情報</h2>
      </div>
      <div class="paper-panel rounded-3xl bg-paper overflow-hidden">
        <table class="w-full">
          <tbody>
            {[
              { label: '会社名', value: 'OnO International（オーエヌオー・インターナショナル）' },
              { label: '代表者', value: '小野 秀太（Shuta Ono）' },
              { label: '所在地', value: '福岡県福岡市南区西長住1-4-47-2' },
              { label: '事業内容', value: '実店舗向け業務システムの設計・構築／AI構築・コンサルティング／動画制作／空中・水中ドローン撮影／フリーダイビング講習' },
              { label: 'ミッション', value: '人と人、国と国、価値と価値をつなぐ' },
              { label: 'ビジョン', value: '国境や文化の違いを超え、世界中の人々がそれぞれの幸せを実現できる社会をつくる' },
            ].map((row, i) => (
              <tr class={i !== 5 ? 'border-b border-line' : ''}>
                <td class="px-8 py-5 text-muted text-sm font-medium w-1/3 align-top">{row.label}</td>
                <td class="px-8 py-5 text-muted text-sm leading-relaxed">{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="relative rounded-3xl overflow-hidden">
        <div class="absolute inset-0 ink-fill opacity-10"></div>
        <div class="absolute inset-0 border border-line rounded-3xl pointer-events-none"></div>
        <div class="relative z-10 p-6 md:p-16">
          <h2 class="text-2xl md:text-5xl font-black text-ink mb-4">
            <span class="block">一緒に、</span><span class="accent-text">新しい価値を創ろう</span>。
          </h2>
          <p class="text-muted mb-10 max-w-xl mx-auto">
            お店のAI活用から映像制作まで、あなたのビジネスに合った最適な提案をします。
            まずはお気軽にご相談ください。
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={`${base}contact`} class="inline-flex px-10 py-4 rounded-full ink-fill text-paper font-bold hover:opacity-90 transition-all hover:scale-105 shadow-xl shadow-none">
              お問い合わせ →
            </a>
            <a href={`${base}recruit`} class="inline-flex px-10 py-4 rounded-full paper-panel text-muted font-semibold hover:text-ink transition-all border border-line hover:border-line">
              採用情報を見る
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
