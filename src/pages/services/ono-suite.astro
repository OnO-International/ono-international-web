---
import Layout from '../../layouts/Layout.astro';
import { onoSuiteDemo, verifiedDemoUrl } from '../../data/ono-suite';
const base = import.meta.env.BASE_URL;
const contact = `${base}contact?service=ono-suite`;
const oneDemo = verifiedDemoUrl(onoSuiteDemo.oneUrl);
const compassDemo = verifiedDemoUrl(onoSuiteDemo.compassUrl);
const steps = [
  { number: '01', title: '注文を受ける', copy: 'テーブルごとの注文を確認。厨房での提供管理まで、現場の流れに沿って操作します。' },
  { number: '02', title: '会計して、締める', copy: '注文から会計、日報へ。売上を何度も入力し直す負担を減らします。' },
  { number: '03', title: '本部で見渡す', copy: '各店舗の売上や営業状況を確認。店舗の情報を、次の判断につなげます。' },
 ];
const peopleSteps = [
  { number: '01', title: 'スタッフが入社情報を入力', copy: '本人がオンラインで必要事項を入力。本部の転記作業を減らす入口に。' },
  { number: '02', title: '雇用契約を確認・締結', copy: '勤務条件の確認から契約書の保管まで、入社手続きとつなぎます。' },
  { number: '03', title: '所属店舗へ登録', copy: '本部の確認を経て店舗へ配属。同じスタッフ情報を、その後の業務に引き継ぎます。' },
  { number: '04', title: 'POSで勤怠を記録', copy: '現場での打刻・勤怠情報を、本部の確認へ。予定シフトと実際の勤務は分けて扱います。' },
  { number: '05', title: 'Compassで給与明細を管理', copy: '確認した勤怠と支給内容をもとに、明細の管理まで一つの流れへ。' },
  { number: '06', title: '弥生会計へ渡す準備', copy: '店舗と本部で整えた情報を、会計業務へ引き渡すところまで。対応形式と対象データは導入時に確認します。' },
];
---
<Layout title="OnO ONE・OnO COMPASS｜これだけあればいい。" description="これだけあればいい。入社から契約、店舗登録、POS勤怠、給与明細、弥生会計へ渡す準備まで。OnO ONE・OnO COMPASSが目指す、一つにつながる店舗と本部の運営。">
  <article class="suite-page">
    <section class="suite-hero suite-wrap">
      <p class="suite-kicker">OnO RESTAURANT SOLUTIONS</p>
      <div class="hero-grid">
        <div>
          <h1>これだけ<br/>あればいい。</h1>
          <p class="hero-copy">入社から、店舗運営、給与明細。<br/>弥生会計へ渡す準備まで。<br/>お店と本部の仕事を、ひとつの流れへ。</p><p class="suite-note">OnO ONE・OnO COMPASSの統合方針です。入社・契約・給与明細を含む一連の統合は準備中です。</p>
          <div class="suite-actions"><a class="suite-button" href="#experience">製品の体験について <span aria-hidden="true">↓</span></a><a class="suite-textlink" href={contact}>導入を相談する ↗</a></div>
        </div>
        <div class="product-pair" aria-label="店舗用と本部用の製品構成">
          <div class="product-wordmark one"><span class="product-role">店舗運営</span><p>OnO <strong>ONE</strong></p><span>お店の仕事を、ひとつに。</span></div>
          <div class="pair-connection"><span></span><p>店舗の情報を、本部の判断へ。</p><span></span></div>
          <div class="product-wordmark compass"><span class="product-role">本部管理</span><p>OnO <strong>COMPASS</strong></p><span>各店の今を、次の一手に。</span></div>
        </div>
      </div>
      <div class="hero-bottom"><span>店舗にはONE。<br class="mobile-break"/>本部にはCOMPASS。</span><a href="#products">2つの製品を知る ↓</a></div>
    </section>

    <section id="products" class="suite-wrap suite-section">
      <div class="suite-heading"><p class="suite-kicker">01 / TWO PRODUCTS, ONE FLOW</p><h2>現場と経営を、<br/>同じ流れにつなぐ。</h2><p>お店の一日と、本部の仕事。それぞれの役割に合わせた画面で、日々の運営を支えます。</p></div>
      <div class="product-details">
        <section class="detail-one"><p class="suite-kicker">FOR YOUR STORE</p><h3>OnO ONE</h3><p class="product-intro">レジを起点に、<br/>店舗運営をひとつへ。</p><p>予約・注文・会計から、勤怠や日報の確認まで。現場で使う仕事をまとめ、情報の行き来をスムーズにします。</p><ul><li>予約・顧客管理</li><li>注文・厨房の提供管理</li><li>POS会計・日報・売上確認</li><li>スタッフ・勤怠管理</li></ul></section>
        <section class="detail-compass"><p class="suite-kicker">FOR YOUR HEADQUARTERS</p><h3>OnO COMPASS</h3><p class="product-intro">各店の今を、<br/>経営の次の一手へ。</p><p>店舗から届く情報を、本部で見渡す。売上の確認や店舗間の比較、現場との情報共有を支えます。</p><ul><li>店舗別の売上・営業状況の確認</li><li>日報・月次の数字の比較</li><li>スタッフ・勤怠情報の確認</li><li>本部と店舗の情報共有</li></ul></section>
      </div>
      <p class="suite-note">利用できる機能・連携範囲は、導入する版と店舗の運用に合わせてご案内します。</p>
      <div class="product-screens">
        <figure>
          <a href={`${base}images/ono-suite/one-light.png`} target="_blank" rel="noopener noreferrer" aria-label="OnO ONEのテーブル管理画面を拡大して見る（新しいタブ）"><img src={`${base}images/ono-suite/one-light.png`} alt="OnO ONEのテーブル管理画面。架空の焼肉店の座席と予約状況を表示。" width="1275" height="717" loading="lazy" decoding="async" /></a>
          <figcaption><strong>OnO ONE｜テーブル管理</strong><span>実アプリの画面例／架空データ・2026年11月11日確認</span><a href={`${base}images/ono-suite/one-light.png`} target="_blank" rel="noopener noreferrer">画面を拡大する ↗</a></figcaption>
        </figure>
        <figure>
          <a href={`${base}images/ono-suite/compass-light.png`} target="_blank" rel="noopener noreferrer" aria-label="OnO COMPASSの売上ダッシュボードを拡大して見る（新しいタブ）"><img src={`${base}images/ono-suite/compass-light.png`} alt="OnO COMPASSのKPIダッシュボード。架空の焼肉店の売上と月内の推移を表示。" width="1280" height="720" loading="lazy" decoding="async" /></a>
          <figcaption><strong>OnO COMPASS｜売上ダッシュボード</strong><span>実アプリの画面例／架空データ・2026年11月11日確認</span><a href={`${base}images/ono-suite/compass-light.png`} target="_blank" rel="noopener noreferrer">画面を拡大する ↗</a></figcaption>
        </figure>
      </div>
    </section>

    <section class="flow-section"><div class="suite-wrap suite-section">
      <div class="suite-heading"><p class="suite-kicker">02 / FROM THE FLOOR TO THE OFFICE</p><h2>一件の注文から、<br/>お店全体の動きまで。</h2></div>
      <ol class="flow-list">{steps.map(step => <li><span class="step-number">{step.number}</span><div><h3>{step.title}</h3><p>{step.copy}</p></div></li>)}</ol>
    </div></section>

    <section id="people-flow" class="suite-wrap suite-section people-section">
      <div class="suite-heading"><p class="suite-kicker">PEOPLE / ONE CONNECTED FLOW</p><h2>入社したその日から、<br/>会計へ渡す準備まで。</h2><p>人の情報を、仕事のたびに登録し直さない。Atmos In Fileの入社手続きをCompassへ統合し、店舗と本部の業務をつなぐ計画です。</p></div>
      <div class="integration-status"><strong>一連の統合は準備中</strong><p>現在の入社アプリを継続しながら、Compassへの統合・データ引継ぎ・権限・連携を順に確認します。以下は統合後に目指す業務の流れで、全工程の本番稼働を示すものではありません。</p></div>
      <ol class="flow-list people-flow">{peopleSteps.map(step => <li><span class="step-number">{step.number}</span><div><h3>{step.title}</h3><p>{step.copy}</p></div></li>)}</ol>
      <div class="people-access"><h3>本部の情報は、許可された担当者だけに。</h3><p>入社・雇用契約の管理はCompassの設定内へ。閲覧できる本部担当者を限定し、店舗や一般スタッフに不要な情報を見せない設計で進めます。</p></div>
      <p class="suite-note">給与明細管理は、税・社会保険料の自動計算や振込までの対応を意味しません。弥生会計本体は対象外です。会計への受渡し方法・対応形式は検証のうえご案内します。</p>
    </section>

    <section id="experience" class="suite-wrap suite-section">
      <div class="suite-heading"><p class="suite-kicker">03 / PRODUCT EXPERIENCE</p><h2>説明を聞くだけでなく、<br/>操作して、確かめる。</h2><p>製品と同じ画面・操作を、架空の店舗データで体験する環境をご用意します。商談では、普段のお店の流れに合わせてご案内します。</p></div>
      <div class="experience-panel">
        <div><span class="experience-label">架空の店舗・売上・スタッフデータ</span><h3>OnO ONE ＋ OnO COMPASS</h3><p>注文・会計から本部での確認まで。実際に操作しながら、店舗での使い方をご検討いただけます。</p></div>
        <div class="experience-actions">
          {oneDemo && <a class="suite-button" href={oneDemo} target="_blank" rel="noopener noreferrer">OnO ONEを体験する ↗</a>}
          {compassDemo && <a class="suite-button secondary" href={compassDemo} target="_blank" rel="noopener noreferrer">OnO COMPASSを体験する ↗</a>}
          {(!oneDemo || !compassDemo) && <><p class="availability">{oneDemo || compassDemo ? '公開準備中の製品は、個別にご案内します。' : 'オンライン体験環境は準備中です。製品体験をご希望の方はお問い合わせください。'}</p><a class="suite-button" href={`${contact}&intent=demo`}>製品体験を相談する ↗</a></>}
          {onoSuiteDemo.release && (oneDemo || compassDemo) && <p class="suite-note">体験版：{onoSuiteDemo.release}</p>}
        </div>
      </div>
      <p class="suite-note">デモは共有環境です。入力した注文や会計は画面を閉じても残り、ほかの体験者にも表示されます。個人情報は入力しないでください。実決済や外部への送信は行いません。</p>
    </section>

    <section class="suite-wrap suite-section introduction">
      <div class="suite-heading"><p class="suite-kicker">04 / FIT TO YOUR OPERATION</p><h2>お店のやり方から、<br/>導入を考えます。</h2></div>
      <div class="introduction-grid"><div><span>01 — HEARING</span><h3>現場の流れを伺う</h3><p>店舗数、注文の取り方、会計、日報、本部への報告。いまの運用と困りごとを整理します。</p></div><div><span>02 — EXPERIENCE</span><h3>実際の操作を確認する</h3><p>必要な機能を一緒に操作。端末・プリンター・既存サービスとの連携条件も確認します。</p></div><div><span>03 — PROPOSAL</span><h3>導入範囲をご提案する</h3><p>使う機能、設定、サポートの範囲に合わせてお見積り。導入の進め方を具体化します。</p></div></div>
    </section>

    <section class="suite-faq suite-wrap suite-section">
      <p class="suite-kicker">QUESTIONS</p><h2>導入前に知っておきたいこと</h2>
      <details><summary>いま使っているレジや端末を使えますか？</summary><p>端末の機種、ブラウザー、プリンター、決済サービスなどを確認し、利用できる構成をご案内します。既存機器への対応を一律にはお約束せず、導入前に確認します。</p></details>
      <details><summary>「これだけあればいい」は、どこまでを目指していますか？</summary><p>入社情報の入力、雇用契約、店舗登録、POS勤怠、給与明細管理から、弥生会計へ渡す準備までを一つにつなぐ方針です。一連の統合は準備中で、現時点で全工程が連携済みという意味ではありません。弥生会計そのものの置換や、税・社会保険料の全自動計算をお約束するものではなく、導入時に利用できる範囲を確認します。</p></details>
      <details><summary>料金はどのように決まりますか？</summary><p>店舗数、必要な機能、初期設定、連携・サポートの範囲を確認してお見積りします。まずは現在の運営状況をお聞かせください。</p></details>
      <details><summary>体験用のデータは実際のお店のものですか？</summary><p>いいえ。体験には架空の店舗・売上・スタッフデータを使います。実際のお客様の情報や営業データを公開するものではありません。</p></details>
    </section>

    <section class="suite-cta"><div class="suite-wrap"><p class="suite-kicker">LET’S TALK ABOUT YOUR STORE</p><h2>あなたのお店なら、<br/>どう使えるだろう。</h2><p>一店舗から、本部での多店舗管理まで。<br/>まずは、いまの運営についてお聞かせください。</p><a class="suite-button" href={contact}>OnO ONE・COMPASSを相談する ↗</a></div></section>
  </article>
</Layout>
<style>
  .people-section{border-bottom:1px solid var(--line)}.integration-status{padding:24px 28px;background:var(--suite-peach);border-left:4px solid var(--orange);margin-bottom:40px}.integration-status strong{font-size:15px}.integration-status p,.people-access p{font-size:14px;line-height:2;color:var(--muted);margin-top:12px}.people-flow{row-gap:40px}.people-access{margin-top:44px;padding:28px;background:var(--paper);border:1px solid var(--line)}.people-access h3{font-size:20px;font-weight:700;line-height:1.7}

  .product-screens{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:40px}.product-screens figure{min-width:0;margin:0}.product-screens figure>a{display:block;border:1px solid var(--line);border-radius:5px;overflow:hidden;background:var(--sand)}.product-screens img{display:block;width:100%;height:auto}.product-screens figcaption{display:flex;flex-direction:column;align-items:flex-start;gap:8px;padding-top:16px;line-height:1.7}.product-screens figcaption strong{font-size:14px}.product-screens figcaption span{font-size:11px;color:var(--muted)}.product-screens figcaption>a{font-size:12px;text-decoration:underline;text-underline-offset:4px;color:var(--blue)}
  @media(max-width:700px){.product-screens{grid-template-columns:1fr;gap:32px}}

  .suite-page{--suite-cream:#fffcf6;--suite-peach:#fff0e4;--suite-sand:#f8eee2;--suite-warm-line:#e7cdb9;overflow:hidden;background:var(--suite-cream)}.suite-wrap{max-width:1160px;margin:auto;padding-left:32px;padding-right:32px}.suite-section{padding-top:100px;padding-bottom:100px}.suite-kicker{font-size:11px;font-weight:700;letter-spacing:.14em;color:var(--blue);margin-bottom:24px}.suite-hero{padding-top:160px}.hero-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:64px;align-items:center}.suite-hero h1{font-size:clamp(40px,4.8vw,64px);font-weight:900;line-height:1.4;letter-spacing:-.055em}.suite-hero h1 span{color:var(--blue)}.hero-copy{margin-top:26px;font-size:18px;line-height:2;color:var(--muted)}.suite-actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-top:32px}.suite-button{display:inline-flex;align-items:center;justify-content:space-between;gap:22px;padding:18px 24px;border-radius:5px;background:var(--ink);color:var(--paper);font-size:14px;font-weight:700;line-height:1.7;transition:background .2s}.suite-button:hover{background:var(--blue)}.suite-textlink{font-size:13px;font-weight:700}.product-pair{padding:20px 0}.product-wordmark{padding:32px;border:1px solid var(--line);background:var(--paper);border-radius:5px}.product-wordmark.one{border-top:4px solid var(--blue)}.product-wordmark.compass{background:var(--suite-peach);color:var(--ink);border-color:var(--suite-warm-line);border-top:4px solid var(--orange)}.product-role{font-size:11px;letter-spacing:.15em}.product-wordmark p{font-size:clamp(24px,3.2vw,42px);letter-spacing:-.04em;margin:12px 0}.product-wordmark strong{font-weight:700}.product-wordmark>span:last-child{font-size:13px;opacity:.8}.pair-connection{display:flex;align-items:center;justify-content:center;gap:12px;margin:20px 0}.pair-connection p{font-size:11px;color:var(--muted)}.pair-connection span{height:1px;width:24px;background:var(--line)}.hero-bottom{display:flex;justify-content:space-between;gap:24px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:64px;padding:22px 0;font-size:13px}.hero-bottom>span{font-weight:700}.hero-bottom a{color:var(--muted)}.suite-heading{max-width:720px;margin-bottom:48px}.suite-heading h2,.suite-cta h2{font-size:clamp(29px,3.8vw,44px);font-weight:700;line-height:1.55}.suite-heading>p:last-child:not(.suite-kicker){max-width:600px;margin-top:24px;font-size:16px;color:var(--muted);line-height:2}.product-details{display:grid;grid-template-columns:1fr 1fr;gap:40px}.product-details>section{border-top:3px solid var(--blue);padding:32px;background:var(--paper)}.product-details .detail-compass{border-color:var(--orange);background:var(--suite-peach)}.product-details h3{font-size:32px;font-weight:700;letter-spacing:-.04em}.product-intro{font-size:23px;font-weight:700;margin:24px 0;line-height:1.7}.product-details p:not(.suite-kicker):not(.product-intro){color:var(--muted);line-height:2;font-size:14px}.product-details ul{margin-top:28px}.product-details li{padding:13px 0;border-top:1px solid var(--line);font-size:14px}.product-details li:before{content:'＋';margin-right:12px;color:var(--blue)}.suite-note{font-size:12px;color:var(--muted);line-height:1.9;margin-top:20px}.flow-section{background:var(--suite-sand)}.flow-list{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}.step-number{font-size:54px;letter-spacing:-.07em;font-weight:500;color:var(--blue);display:block;padding-bottom:20px;border-bottom:1px solid var(--line);margin-bottom:24px}.flow-list h3{font-size:22px;font-weight:700;margin-bottom:16px}.flow-list p,.introduction-grid p{font-size:14px;color:var(--muted);line-height:2}.experience-panel{border:1px solid var(--line);border-left:4px solid var(--blue);padding:40px;display:grid;grid-template-columns:1.2fr 1fr;gap:40px;background:var(--paper)}.experience-label{font-size:11px;color:var(--blue);font-weight:700}.experience-panel h3{font-size:25px;font-weight:700;margin:16px 0}.experience-panel p{line-height:2;font-