---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'OnO INTERNATIONALは、動画制作・AI構築・フリーダイビング映像サービスで企業さまをコンサルティングする会社です。' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="pkIaklxAVA2f3rqYO4OPTXvL6R1nBBD_wAgOkJ46z1Y" />
    <!-- OGP -->
    <meta property="og:title" content={`${title} | OnO INTERNATIONAL`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://ono-international.com/logo%20ono.png" />
    <meta property="og:site_name" content="OnO INTERNATIONAL" />
    <meta property="og:locale" content="ja_JP" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | OnO INTERNATIONAL`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ono-international.com/logo%20ono.png" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}logo.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | OnO INTERNATIONAL</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GLW20WQESK"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GLW20WQESK');
    </script>
  </head>
  <body class:list={[{ 'home-page': Astro.url.pathname === base, 'interior-page': Astro.url.pathname !== base }]}>
    <a class="skip-link" href="#main-content">本文へスキップ</a>
    <header id="header" class="site-header">
      <a href={base} class="site-brand" aria-label="OnO INTERNATIONAL ホーム"><img src={`${base}logo.png`} alt=""/><span>OnO<small>INTERNATIONAL</small></span></a>
      <span class="header-note">ONE &amp; ONLY PARTNER.<br/><span>FUKUOKA, JAPAN</span></span>
      <div class="header-actions"><a href={`${base}contact`} class="header-contact">お問い合わせ ↗</a><button id="menu-btn" aria-label="メニューを開く" aria-controls="fullmenu" aria-expanded="false"><span>MENU</span><i aria-hidden="true"></i></button></div>
    </header>
    <dialog id="fullmenu" class="fullmenu" aria-label="サイトメニュー">
      <div class="menu-top"><span class="eyebrow">OnO INTERNATIONAL</span><button id="fullmenu-close" aria-label="メニューを閉じる">CLOSE <span aria-hidden="true">×</span></button></div>
      <div class="menu-body"><p class="menu-message">人と人。<br/>想いと未来。<br/><span>そのあいだに、OnO。</span></p><nav aria-label="メインナビゲーション">
        {[
          {href:base, en:'HOME', jp:'トップページ'}, {href:`${base}services`,en:'SERVICE',jp:'サービス'}, {href:`${base}about`,en:'ABOUT',jp:'会社概要'}, {href:`${base}news`,en:'NEWS',jp:'最新情報'}, {href:`${base}recruit`,en:'RECRUIT',jp:'採用情報'}, {href:`${base}contact`,en:'CONTACT',jp:'お問い合わせ'},
        ].map((item,i) => <a href={item.href}><small>0{i+1}</small><strong>{item.en}</strong><span>{item.jp}</span><span aria-hidden="true">↗</span></a>)}
      </nav></div><p class="menu-bottom">© 2011 OnO INTERNATIONAL. All rights reserved.</p>
    </dialog>

    <main id="main-content"><slot /></main>

    <footer class="site-footer">
      <div class="footer-top"><a href={`${base}contact`} class="footer-hello">LET’S TALK<span>↗</span></a><p>お店の常識を、AIで塗り替える。</p></div>
      <div class="footer-links"><a href={base} class="site-brand"><img src={`${base}logo.png`} alt=""/><span>OnO<small>INTERNATIONAL</small></span></a><div><p class="eyebrow">SERVICES</p><a href={`${base}services/restaurant-web`}>実店舗 Web集客支援</a><a href={`${base}services/ai`}>AI構築・コンサルティング</a><a href={`${base}services/video`}>動画制作</a><a href={`${base}services/drone`}>空中・水中ドローン撮影</a><a href={`${base}services/freediving`}>フリーダイビング講習</a></div><div><p class="eyebrow">INFORMATION</p><a href={`${base}about`}>会社概要</a><a href={`${base}news`}>News &amp; Blog</a><a href={`${base}recruit`}>採用情報</a><a href={`${base}contact`}>お問い合わせ</a></div></div>
      <div class="footer-bottom"><span>© 2011 OnO INTERNATIONAL. All rights reserved.</span><a href="#main-content">BACK TO TOP ↑</a></div>
    </footer>

    <aside id="restaurant-banner" class="restaurant-banner is-suppressed" hidden={Astro.url.pathname.replace(/\/$/, '').endsWith('/contact') || Astro.url.pathname.replace(/\/$/, '').endsWith('/services/restaurant-web')} aria-label="実店舗向けサービス">
      <a href={`${base}services/restaurant-web`}><span class="banner-symbol" aria-hidden="true">↗</span><span><small>FOR LOCAL BUSINESSES</small><strong>実店舗を持つ全ての方へ</strong><span>Web集客支援・月額8万円・まるごとお任せ</span></span></a><button id="banner-close" aria-label="サービスの案内を閉じる">×</button>
    </aside>

    <script>
      const menuButton = document.getElementById('menu-btn');
      const menu = document.getElementById('fullmenu') as HTMLDialogElement;
      const closeButton = document.getElementById('fullmenu-close');
      menuButton?.addEventListener('click', () => { menu.showModal(); menuButton.setAttribute('aria-expanded','true'); document.body.style.overflow = 'hidden'; });
      closeButton?.addEventListener('click', () => menu.close());
      menu?.addEventListener('close', () => { menuButton?.setAttribute('aria-expanded','false'); document.body.style.overflow = ''; menuButton?.focus(); });
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.close()));

      const banner = document.getElementById('restaurant-banner');
      let bannerClosed = false;
      try { bannerClosed = sessionStorage.getItem('bannerClosed') === '1'; } catch {}
      if (bannerClosed) banner?.setAttribute('hidden','');
      document.getElementById('banner-close')?.addEventListener('click', () => { bannerClosed = true; banner?.setAttribute('hidden',''); try { sessionStorage.setItem('bannerClosed','1'); } catch {} });
      const hero = document.querySelector('main > section:first-child, main > article:first-child');
      const footer = document.querySelector('.site-footer');
      let heroVisible = true;
      let footerVisible = false;
      const updateBanner = () => banner?.classList.toggle('is-suppressed', heroVisible || footerVisible);
      if (hero) new IntersectionObserver(([entry]) => { heroVisible = entry.isIntersecting; updateBanner(); }).observe(hero);
      if (footer) new IntersectionObserver(([entry]) => { footerVisible = entry.isIntersecting; updateBanner(); }).observe(footer);
    </script>
  </body>
</html>
