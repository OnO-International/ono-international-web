---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="フリーダイビング講習 | Team Dragon" description="Team Dragonのフリーダイビング講習。初心者から上級者まで、法人福利厚生プログラムも対応。SNSI認定コース。OnO INTERNATIONAL。">

  <!-- Hero -->
  <section class="freediving-hero relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    <div class="hero-video" aria-hidden="true">
      <video
        src={`${base}hero_bg.mp4`}
        autoplay
        muted
        loop
        playsinline
        tabindex="-1"
      ></video>
    </div>
    <div class="hero-video-shade" aria-hidden="true"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-32 pb-20">
      <!-- Team Dragon badge -->
      <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl paper-panel border border-line mb-8">
        <span class="text-2xl">🐉</span>
        <div class="text-left">
          <p class="text-blue text-xs font-bold tracking-widest">TEAM DRAGON</p>
          <p class="text-muted text-xs">OnO International Freediving Team</p>
        </div>
      </div>
      <h1 class="text-5xl md:text-7xl font-black mb-6 leading-tight">
        <span class="block text-paper">深く、静かに、</span>
        <span class="block text-paper">自由になる。</span>
      </h1>
      <p class="text-paper text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
        息を止めて、海に潜る。<br class="hidden md:block"/>
        Team Dragonが、フリーダイビングの素晴らしさをあなたに届けます。
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={`${base}contact`} class="px-8 py-4 rounded-full text-ink font-bold text-sm hover:opacity-90 transition-all hover:scale-105 shadow-lg" style="background: var(--blue); color: var(--paper);">
          体験・申込みはこちら →
        </a>
        <a href="#courses" class="px-8 py-4 rounded-full paper-panel text-muted font-semibold text-sm hover:text-ink transition-all border border-line">
          コース一覧を見る
        </a>
      </div>
    </div>
  </section>

  <!-- Team Dragon紹介 -->
  <section class="py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="paper-panel rounded-3xl p-10 md:p-14 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-80 h-80 bg-sand rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-60 h-60 bg-sand rounded-full blur-3xl"></div>
        <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span class="text-5xl">🐉</span>
              <div>
                <h2 class="text-xl md:text-3xl font-black text-ink">Team Dragon</h2>
                <p class="text-blue text-sm font-medium">OnO International Freediving Team</p>
              </div>
            </div>
            <p class="text-muted leading-relaxed mb-4">
              Team Dragonは、OnO Internationalが運営するフリーダイビングチームです。
              「龍のように深く、自由に海を泳ぐ」というビジョンのもと、
              初心者から競技者まで幅広い層にフリーダイビングの魅力を伝えています。
            </p>
            <p class="text-muted leading-relaxed">
              代表の小野秀太をはじめ、経験豊富なインストラクター陣が
              安全を最優先に、一人ひとりのペースに合わせた丁寧な指導を行います。
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              { num: '30m+', label: '最大潜水深度' },
              { num: 'SNSI', label: '国際認定コース' },
              { num: '講習', label: '初心者から競技者まで' },
              { num: '安全', label: '最優先の指導方針' },
            ].map((stat) => (
              <div class="bg-sand rounded-2xl p-6 text-center">
                <div class="text-2xl font-black mb-2" style="color: var(--blue);">{stat.num}</div>
                <div class="text-muted text-xs">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- フリーダイビングとは -->
  <section id="about-freediving" class="freediving-about py-20 px-6">
    <img class="dragon-watermark" src={`${base}images/team-dragon-logo.webp`} alt="" aria-hidden="true" width="800" height="800" loading="lazy" />
    <div class="relative z-10 max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-blue text-sm font-medium tracking-widest mb-3">ABOUT FREEDIVING</p>
        <h2 class="text-2xl md:text-4xl font-black text-ink mb-4">フリーダイビングって何？</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {[
          { icon: '🌊', title: '息を止めて潜る', desc: 'タンクなしで息を止めて潜る、シンプルで奥深いダイビングスタイル。自分の体だけで海と向き合います。' },
          { icon: '🧘', title: '心と体が整う', desc: '呼吸法・リラクゼーション・集中力が高まります。日常のストレスから解放され、深い静けさを体感できます。' },
          { icon: '🐬', title: '生き物に近づける', desc: 'タンクの音がないため、海洋生物との距離が縮まります。イルカ・クジラ・マンタとの感動的な出会いも。' },
        ].map((item) => (
          <div class="paper-panel rounded-2xl bg-paper p-8 text-center">
            <div class="text-5xl mb-5">{item.icon}</div>
            <h3 class="text-ink font-bold text-lg mb-3">{item.title}</h3>
            <p class="text-muted text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- コース一覧 -->
  <section id="courses" class="py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-blue text-sm font-medium tracking-widest mb-3">COURSES</p>
        <h2 class="text-2xl md:text-4xl font-black text-ink mb-4">コース一覧</h2>
        <p class="text-muted max-w-5xl mx-auto md:whitespace-nowrap">初心者から競技者まで、あなたのレベルと目標に合った<span class="whitespace-nowrap">コースをご用意しています。</span></p>
      </div>
      <div class="space-y-6">
        {[
          {
            level: 'BEGINNER',
            color: 'text-blue bg-sand border-line',
            icon: '🌱',
            title: '体験フリーダイビング',
            desc: '「フリーダイビングってどんなもの？」という方向けの体験コース。プールや浅い海で基本的な呼吸法と潜り方を学びます。泳げれば誰でも参加できます。',
            includes: ['基本呼吸法', '水中リラクゼーション', 'インストラクター同伴での潜水'],
          },
          {
            level: 'BEGINNER→INTERMEDIATE',
            color: 'text-blue bg-sand border-line',
            icon: '🐟',
            title: 'SNSI 初級コース',
            desc: '国際認定資格を取得できるエントリーコース。深度20mまでの潜水技術・安全知識を習得します。世界中の海でフリーダイビングを楽しめる資格です。',
            includes: ['深度目標 10〜20m', '水中安全知識', 'SNSI国際認定証', '救助・安全管理'],
          },
          {
            level: 'INTERMEDIATE',
            color: 'text-blue bg-sand border-line',
            icon: '🦈',
            title: 'SNSI 中級コース',
            desc: '深度30mを目指す中級コース。より高度な呼吸法・リカバリー技術・ディープダイビングの知識を習得します。',
            includes: ['深度目標 20〜30m', '高度な呼吸法', '救助訓練', 'プールアプネア'],
          },
          {
            level: 'ADVANCED',
            color: 'text-blue bg-sand border-line',
            icon: '🐉',
            title: 'アドバンス・競技コース',
            desc: 'Team Dragon独自の競技志向プログラム。大会参加を目指す方、さらなる深度を追求する方向けの特別コースです。',
            includes: ['個別パフォーマンス分析', '競技対策トレーニング', 'Team Dragon特別サポート', '大会帯同サポート'],
          },
          {
            level: 'CORPORATE',
            color: 'text-blue bg-sand border-line',
            icon: '🏢',
            title: '法人福利厚生プログラム',
            desc: '企業向けのチームビルディング・福利厚生として提供。社員の心身リフレッシュ・チームの絆強化に最適です。OnO社員も福利厚生として楽しんでいます。',
            includes: ['グループ体験プログラム', 'チームビルディング企画', '安全管理スタッフ完備', '法人契約対応'],
          },
        ].map((course) => (
          <div class="paper-panel rounded-2xl bg-paper p-8 md:p-10">
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="text-5xl flex-shrink-0">{course.icon}</div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class={`text-xs font-bold px-3 py-1 rounded-full border ${course.color}`}>{course.level}</span>
                </div>
                <h3 class="text-2xl font-black text-ink mb-3">{course.title}</h3>
                <p class="text-muted leading-relaxed mb-5">{course.desc}</p>
                <div class="flex flex-wrap gap-2">
                  {course.includes.map((item) => (
                    <span class="text-xs px-3 py-1.5 rounded-full bg-sand text-muted border border-line">{item}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 安全へのこだわり -->
  <section class="py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-blue text-sm font-medium tracking-widest mb-3">SAFETY FIRST</p>
        <h2 class="text-2xl md:text-4xl font-black text-ink mb-4">安全への絶対的なこだわり</h2>
        <p class="text-muted max-w-3xl mx-auto">フリーダイビングを「危険なスポーツ」と思わせない。<br/>それがTeam Dragonの使命です。</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { icon: '👥', title: '必ず2人以上', desc: '「Never Dive Alone」の原則を徹底。常にバディと一緒に安全を確認します。' },
          { icon: '📚', title: '知識から始める', desc: '水中生理学・ブラックアウト予防など、必要な知識を十分に学んでから水中へ。' },
          { icon: '🩺', title: '健康確認', desc: '参加前の健康チェックを実施。持病がある方も事前相談で対応します。' },
          { icon: '🛟', title: '救助訓練完備', desc: 'インストラクター全員が救助技術を習得。緊急時の対応体制を常に整えています。' },
        ].map((item) => (
          <div class="paper-panel rounded-2xl bg-paper p-6 text-center">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-ink font-bold mb-2">{item.title}</h3>
            <p class="text-muted text-xs leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <div class="relative rounded-3xl overflow-hidden">
        <div class="absolute inset-0 opacity-15" style="background: var(--blue); color: var(--paper);"></div>
        <div class="absolute inset-0 border border-line rounded-3xl pointer-events-none"></div>
        <div class="relative z-10 p-6 md:p-20">
          <div class="text-6xl mb-6">🐉</div>
          <h2 class="text-2xl md:text-5xl font-black text-ink mb-4">
            <span class="block">Team Dragonと、</span><span style="color: var(--blue);">海へ飛び込もう。</span>
          </h2>
          <p class="text-muted mb-10 max-w-xl mx-auto">
            「泳げるけど潜ったことがない」でも大丈夫。
            まずは体験コースから。あなたの海が、ここから始まります。
          </p>
          <a href={`${base}contact`} class="inline-flex px-10 py-4 rounded-full text-ink font-bold hover:opacity-90 transition-all hover:scale-105 shadow-xl" style="background: var(--blue); color: var(--paper);">
            体験・申込みはこちら →
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .freediving-about {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .dragon-watermark {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0.55;
    pointer-events: none;
  }
  .freediving-about .paper-panel {
    background: color-mix(in srgb, var(--paper) 90%, transparent);
  }
  .freediving-about > div > .text-center {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding: 20px 28px;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
  }
  /* Fill the Hero with the original video on desktop and mobile. */
  .freediving-hero {
    background: #183746;
    isolation: isolate;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background: #183746;
  }
  .hero-video video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    /* The source has roughly 15% letterboxing at each edge. */
    height: 144%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform: translate(-50%, -50%);
  }
  .hero-video-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 24 32 / 40%), rgb(7 24 32 / 62%));
    pointer-events: none;
  }
  .freediving-hero h1 {
    text-shadow: 0 2px 20px rgb(0 0 0 / 25%);
  }
</style>
